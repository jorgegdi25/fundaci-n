NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until content, payments and privacy have been approved for launch.
SITE_INDEXABLE=false
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Only needed for the explicit cms:seed script. Never exposed in the browser.
SANITY_API_WRITE_TOKEN=
# The payment integration accepts only Sandbox credentials. Complete all five
# values and provision the Sandbox ledger. Private keys remain server-only.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Separate Sandbox donation ledger provisioned through Vercel Marketplace.
DATABASE_URL=
# Generated secret for the monthly scheduler. Never expose it in the browser.
CRON_SECRET=
# PayPal Sandbox. Client ID is public; all other configuration stays server-only.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_PLAN_USD=
PAYPAL_PLAN_EUR=
PAYPAL_WEBHOOK_ID=
# Newsletter: Apps Script endpoint owned by the foundation. Server-only values.
# Enable only after confirming the client Sheet's columns and approved policies.
COMMUNITY_SHEETS_ENDPOINT=
COMMUNITY_SHEETS_SECRET=
