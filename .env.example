NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until content, payments and privacy have been approved for launch.
SITE_INDEXABLE=false
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Only needed for the explicit cms:seed script. Never exposed in the browser.
SANITY_API_WRITE_TOKEN=
# The payment integration accepts only Sandbox credentials. Complete all five
# values and provision the Sandbox ledger. Private keys remain server-only.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Separate Sandbox donation ledger provisioned through Vercel Marketplace.
DATABASE_URL=
# Generated secret for the monthly scheduler. Never expose it in the browser.
CRON_SECRET=
# PayPal Sandbox. Client ID is public; all other configuration stays server-only.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_PLAN_USD=
PAYPAL_PLAN_EUR=
PAYPAL_WEBHOOK_ID=
# Live: Production only, separate from all Sandbox resources. Saving these
# does not enable checkout. Use a dedicated database with paypal-live-schema.sql.
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_MERCHANT_ID=
PAYPAL_LIVE_PLAN_USD=
PAYPAL_LIVE_PLAN_EUR=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_DATABASE_URL=
# Empty = disabled. review = immutable staged Production URL only.
# public requires a separate release decision after the complete payment test.
PAYPAL_LIVE_CHECKOUT_STAGE=
# Independent opt-in: review redirects to webmaster; public uses real recipients.
PAYPAL_LIVE_EMAILS_ENABLED=
PAYPAL_LIVE_RESEND_API_KEY=
PAYPAL_LIVE_EMAIL_FROM=
PAYPAL_LIVE_TEST_RECIPIENT=
PAYPAL_LIVE_EMAIL_START_AT=
# Newsletter: Apps Script endpoint owned by the foundation. Server-only values.
# Enable only after confirming the client Sheet's columns and approved policies.
COMMUNITY_SHEETS_ENDPOINT=
COMMUNITY_SHEETS_SECRET=
# Donation emails stay disabled until the Sandbox schema and sending domain
# have been verified. Set ENABLED to sandbox only for an approved email test.
# Both donor and internal notices are redirected to the single test recipient.
DONATION_EMAILS_ENABLED=
RESEND_API_KEY=
DONATION_EMAIL_FROM=
DONATION_TEST_RECIPIENT=
# ISO timestamp: do not email donations made before the activation date.
DONATION_EMAIL_START_AT=
